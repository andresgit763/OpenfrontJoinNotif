<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openfrontmod.mapwatch</string>
    <key>ProgramArguments</key>
    <array>
        <string>__APP_BIN__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart the app whenever it exits. The menu's Quit unloads the job
         for the login session instead, so quitting still works. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/openfrontmapwatch.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/openfrontmapwatch.err</string>
</dict>
</plist>
